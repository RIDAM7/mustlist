# Copy to .env.local for local development. Never commit real values.

# Canonical site origin (defaults to https://ridamagrawal.com).
# NEXT_PUBLIC_SITE_URL=https://ridamagrawal.com

# Read-only GitHub token for requests (Discussions) and proposals (pull requests).
# Fine-grained token for this repository with read-only access to: Contents,
# Discussions, Pull requests and Commit statuses (Metadata is added automatically).
# Without it the site shows the sample data, labelled as sample. Production builds
# on Vercel refuse to start without it.
# Locally you can use your GitHub CLI login instead:
#   MUSTLIST_GITHUB_TOKEN="$(gh auth token)" pnpm dev
MUSTLIST_GITHUB_TOKEN=

# Secret of the repository webhook that points at /library/api/github/webhook
# (events: discussions, discussion comments, pull requests, pull request reviews,
# check suites and runs, statuses, pushes). Each delivery refreshes the data.
MUSTLIST_WEBHOOK_SECRET=
